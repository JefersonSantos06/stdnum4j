<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jefersonsantos06</groupId>
        <artifactId>stdnum4j-parent</artifactId>
        <version>1.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>stdnum4j-all</artifactId>
    <!--
      A dependency aggregator: it carries no code, only the whole module list, so
      that one coordinate puts all 451 types on the classpath. `pom` packaging is
      what that is — and it keeps this module from having to publish a jar with
      nothing in it. Its test sources are the other half of what it is for: the
      checks that only mean something with the entire registry present, which is
      why the test lifecycle below is wired on by hand. `pom` does not bring one.
    -->
    <packaging>pom</packaging>
    <name>stdnum4j :: all</name>
    <description>Aggregator that depends on every number module and sweeps the whole registry with the generic contract.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-br</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-international</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-eu</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-latam</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-na</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-apac</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-africa</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-postal</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jefersonsantos06</groupId>
            <artifactId>stdnum4j-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-resources</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>testResources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
