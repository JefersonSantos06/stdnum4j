# Postal code shapes of every country and territory: the pattern a code
# matches once its separators are gone, the way it is written, and the
# examples its issuer publishes.
# Generated from Google's address metadata (libaddressinput),
# https://chromium-i18n.appspot.com/ssl-address/data/<CC>, retrieved 2026-09-03.
# Data licence: CC BY 4.0, https://creativecommons.org/licenses/by/4.0/
#
# zip       the source's regex, kept so that a regeneration diff reads
# pattern   that regex over the compact form: separators dropped, an
#           optional prefix lifted into strip. Every backslash is doubled
#           here because the reader turns \x into x.
# masks     how the code is written, from the examples: 9 digit, A letter
# examples  the source's examples, as written
# strip     prefixes compact() removes when the pattern does not want them
# name      the country; kind, the source's word for the code when it is
#           not simply postal
AC zip="ASCN 1ZZ" pattern="ASCN1ZZ" masks="AAAA 9AA" examples="ASCN 1ZZ" strip="AC" name="Ascension Island"
AD zip="AD[1-7]0\\d" pattern="AD[1-7]0\\d" examples="AD100,AD501,AD700" strip="AD" name="Andorra"
AF zip="\\d{4}" pattern="\\d{4}" examples="1001,2601,3801" strip="AF" name="Afghanistan"
AI zip="(?:AI-)?2640" pattern="2640" examples="2640" strip="AI" name="Anguilla"
AL zip="\\d{4}" pattern="\\d{4}" examples="1001,1017,3501" strip="AL" name="Albania"
AM zip="(?:37)?\\d{4}" pattern="(?:37)?\\d{4}" examples="375010,0002,0010" strip="AM" name="Armenia"
AR zip="[A-HJ-NP-Z]\\d{4}[A-Z]{3}" pattern="[A-HJ-NP-Z]\\d{4}[A-Z]{3}" examples="C1070AAM,C1000WAM,B1000TBU,X5187XAB" strip="AR" name="Argentina"
AS zip="(96799)(?:[ \\-](\\d{4}))?" pattern="(96799)(?:(\\d{4}))?" examples="96799" strip="AS" name="American Samoa" kind="zip"
AT zip="\\d{4}" pattern="\\d{4}" examples="1010,3741" strip="AT" name="Austria"
AU zip="\\d{4}" pattern="\\d{4}" examples="2060,3171,6430,4000,4006,3001" strip="AU" name="Australia"
AX zip="22\\d{3}" pattern="22\\d{3}" examples="22150,22550,22240,22710,22270,22730,22430" strip="AX" name="Åland Islands"
AZ zip="\\d{4}" pattern="\\d{4}" examples="1000" strip="AZ" name="Azerbaijan"
