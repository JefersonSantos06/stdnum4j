BD zip="\\d{4}" pattern="\\d{4}" examples="1340,1000" strip="BD" name="Bangladesh"
BE zip="\\d{4}" pattern="\\d{4}" examples="4000,1000" strip="BE" name="Belgium"
BG zip="\\d{4}" pattern="\\d{4}" examples="1000,1700" strip="BG" name="Bulgaria"
BH zip="(?:^|\\b)(?:1[0-2]|[1-9])\\d{2}(?:$|\\b)" pattern="(?:1[0-2]|[1-9])\\d{2}" examples="317" strip="BH" name="Bahrain"
BL zip="9[78][01]\\d{2}" pattern="9[78][01]\\d{2}" examples="97100" strip="BL" name="St. Barthélemy"
